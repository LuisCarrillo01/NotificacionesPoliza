NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notificacion_validacion_poliza
DATABASE_SSL=false

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=8h

VALIDATION_AGENT_BASE_URL=http://localhost:4000
VALIDATION_AGENT_VALIDATE_PATH=/api/validations
VALIDATION_AGENT_TIMEOUT_MS=10000
VALIDATION_RESULT_CALLBACK_TOKEN=change_this_callback_token

BCRYPT_SALT_ROUNDS=10

DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
LOG_LEVEL=info
